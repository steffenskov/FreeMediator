<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>A FOSS re-imaging of the popular MediatR library, striving to stay syntax compatible with MediatR.</Description>
        <PackageProjectUrl>https://github.com/steffenskov/FreeMediator</PackageProjectUrl>
        <PackageTags>mediator, request, response, queries, commands, notifications, CQRS</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../../CHANGELOG.md" Pack="true" PackagePath="\"/>
        <None Include="../../README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

</Project>
